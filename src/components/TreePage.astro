---
import '@/index.css'
import { projectItems } from '@/lib/projects-data'
import ParticlesBackground from '@/components/ParticlesBackground'
import StoreLinkDialogIsland from '@/components/StoreLinkDialogIsland.localized'
import en from '@/i18n/locales/en/main.json'
import el from '@/i18n/locales/el/main.json'

interface Props {
  lang: 'en' | 'el'
}

const { lang } = Astro.props
const locale = lang === 'el' ? el : en
function t(key: string): string {
  return key.split('.').reduce((acc: any, part) => acc?.[part], locale) ?? key
}
const subtitle = (key: string): string | undefined => {
  const value = t(`tree.items.${key}`)
  return value === `tree.items.${key}` ? undefined : value
}

interface TreeLink {
  label: string
  href: string
  icon: 'globe' | 'mail' | 'github' | 'linkedin' | 'instagram' | 'facebook'
}

const homeLinks: TreeLink[] = [
  { label: 'Website', href: 'https://stanimeros.com', icon: 'globe' },
]

const socialLinks: TreeLink[] = [
  { label: 'GitHub', href: 'https://github.com/stanimeros', icon: 'github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/stanimeros', icon: 'linkedin' },
  { label: 'Instagram', href: 'https://www.instagram.com/stanimeros_dev', icon: 'instagram' },
  { label: 'Facebook', href: 'https://www.facebook.com/stanimeros.dev', icon: 'facebook' },
]

const appNames: Record<string, string> = {
  party: 'Party - Play with friends',
  chronal: 'Chronal',
  skiGreece: 'Ski Greece',
  fireMessage: 'Fire Message',
  tattooHealer: 'Tattoo Healer',
  atproPartner: 'ATPRO Partner',
  hedeos: 'Hedeos',
  statwise: 'Statwise',
}

function getInitials(title: string) {
  const fromWords = title
    .split(/\s+/)
    .map((word) => word[0])
    .join("")
    .toUpperCase()
  return fromWords.length >= 2
    ? fromWords.slice(0, 2)
    : (title.replace(/\s/g, "").slice(0, 2).toUpperCase() || "??").padEnd(2, "?")
}

const appLinks = projectItems
  .filter((item) => item.storeLinks?.apple || item.storeLinks?.android || item.storeComingSoon)
  .map((item) => {
    const label = appNames[item.key] ?? item.key
    return {
      label,
      subtitle: subtitle(item.key),
      logo: item.logo,
      initials: getInitials(label),
      bgColor: item.bgColor,
      textColor: item.textColor,
      apple: item.storeLinks?.apple,
      android: item.storeLinks?.android,
      comingSoon: !item.storeLinks?.apple && !item.storeLinks?.android && item.storeComingSoon,
    }
  })

const websiteNames: Record<string, string> = {
  irisdrop: 'IrisDrop',
  athensMytransfer: 'Athens MyTransfer',
  veridictum: 'Veridictum',
  process: 'Process',
  skiGreece: 'Ski Greece',
  nikiMargariti: 'Niki Margariti',
  tattooHealer: 'Tattoo Healer',
  transHellas: 'TransHellas',
  etui: 'Etui Creations',
  hedeos: 'Hedeos',
  ekarotsi: 'e-Karotsi',
}

const websiteLinks = projectItems
  .filter((item) => item.url)
  .map((item) => {
    const label = websiteNames[item.key] ?? item.key
    return {
      label,
      subtitle: subtitle(item.key),
      href: item.url as string,
      logo: item.logo,
      initials: getInitials(label),
      bgColor: item.bgColor,
      textColor: item.textColor,
    }
  })

const icons: Record<TreeLink['icon'], string> = {
  globe: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3 7.5 7.03 7.5 12s2.015 9 4.5 9ZM3.6 9h16.8M3.6 15h16.8"/></svg>',
  mail: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0-.828.672-1.5 1.5-1.5h16.5c.828 0 1.5.672 1.5 1.5v10.5a1.5 1.5 0 0 1-1.5 1.5H3.75a1.5 1.5 0 0 1-1.5-1.5V6.75Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6"/></svg>',
  github: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z"/></svg>',
  linkedin: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.44-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>',
  instagram: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>',
  facebook: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5"><path d="M13.5 21v-7.5h2.5l.4-3H13.5V8.4c0-.87.24-1.46 1.5-1.46h1.6V4.3A21 21 0 0 0 14 4.2c-2.24 0-3.77 1.37-3.77 3.87V10.5H7.7v3h2.53V21h3.27Z"/></svg>',
}

const appleIcon = '<svg viewBox="0 0 24 24" fill="currentColor" class="size-3.5" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>'
const androidIcon = '<svg viewBox="0 0 24 24" fill="currentColor" class="size-3.5" aria-hidden="true"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/></svg>'

const profilePageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  dateCreated: "2026-08-08",
  mainEntity: {
    "@type": "Person",
    name: "Pantelis Stanimeros",
    url: "https://stanimeros.com",
    jobTitle: "Software Engineer",
    image: "https://stanimeros.com/images/pantelis.webp",
    sameAs: [
      "https://github.com/stanimeros",
      "https://www.linkedin.com/in/stanimeros",
      "https://www.instagram.com/stanimeros_dev",
      "https://www.facebook.com/stanimeros.dev",
    ],
  },
}

const canonical = lang === 'el' ? 'https://stanimeros.com/el/tree' : 'https://stanimeros.com/tree'
const otherLangHref = lang === 'el' ? 'https://stanimeros.com/tree' : 'https://stanimeros.com/el/tree'
const title = lang === 'el' ? 'Pantelis Stanimeros | Links' : 'Pantelis Stanimeros | Links'
const description = lang === 'el'
  ? 'Όλα τα links: website, επικοινωνία, social, και εφαρμογές του Pantelis Stanimeros.'
  : 'All the links: website, contact, socials, and apps by Pantelis Stanimeros.'
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href="https://stanimeros.com/tree" />
    <link rel="alternate" hreflang="el" href="https://stanimeros.com/el/tree" />
    <link rel="alternate" hreflang="x-default" href="https://stanimeros.com/tree" />
    <link rel="icon" type="image/png" href="/images/logo-glass-black.png" />
    <link rel="apple-touch-icon" href="/images/logo-glass-black.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap&subset=greek,latin"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://stanimeros.com/images/logo-glass-black.png" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify(profilePageJsonLd)} />
  </head>
  <body>
    <div class="min-h-svh bg-background text-foreground relative">
      <ParticlesBackground client:idle />
      <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-secondary/10" />
      <div class="relative z-10 min-h-svh flex flex-col items-center px-4 py-8">
      <div class="relative w-full max-w-sm flex flex-col items-center">
      <a
        href={otherLangHref}
        class="absolute top-0 right-0 z-20 flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-3 py-1.5 text-xs text-muted-foreground hover:text-foreground hover:border-border transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3 7.5 7.03 7.5 12s2.015 9 4.5 9ZM3.6 9h16.8M3.6 15h16.8"/></svg>
        {t('tree.langSwitch')}
      </a>
      <img
        src="/images/pantelis.webp"
        alt="Pantelis Stanimeros"
        class="size-16 rounded-full object-cover border border-border/60 mb-2"
        width="96"
        height="96"
      />
      <h1 class="text-xl font-semibold">Pantelis Stanimeros</h1>
      <p class="text-muted-foreground text-sm mt-1 mb-5 text-center max-w-xs">
        {t('tree.tagline')}
      </p>
      </div>

      <div class="w-full max-w-sm flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          {homeLinks.map((link) => (
            <a
              href={link.href}
              data-track-section="home"
              data-track-label={link.label}
              class="flex items-center gap-3 w-full rounded-xl border border-border/60 bg-card/70 px-4 py-2.5 text-sm font-medium hover:bg-accent hover:border-border transition-colors"
            >
              <span class="text-primary" set:html={icons[link.icon]} />
              {link.label}
            </a>
          ))}
        </div>

        <div>
          <h2 class="text-xs uppercase tracking-wide text-muted-foreground mb-1.5 px-1">{t('tree.sectionSocial')}</h2>
          <div class="flex flex-col gap-2">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                data-track-section="social"
                data-track-label={link.label}
                class="flex items-center gap-3 w-full rounded-xl border border-border/60 bg-card/70 px-4 py-2.5 text-sm font-medium hover:bg-accent hover:border-border transition-colors"
              >
                <span class="text-primary" set:html={icons[link.icon]} />
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-xs uppercase tracking-wide text-muted-foreground mb-1.5 px-1">{t('tree.sectionApps')}</h2>
          <div class="flex flex-col gap-2">
            {appLinks.map((app) => (
              <div class="flex items-center gap-3 w-full rounded-xl border border-border/60 bg-card/70 px-4 py-2.5">
                {app.logo ? (
                  <img src={app.logo} alt={app.label} class="size-9 rounded-full object-cover shrink-0" />
                ) : (
                  <span class={`size-9 rounded-full flex items-center justify-center text-xs font-bold shrink-0 ${app.bgColor} ${app.textColor}`}>
                    {app.initials}
                  </span>
                )}
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-medium">{app.label}</div>
                  {app.subtitle && (
                    <div class="text-xs text-muted-foreground truncate">{app.subtitle}</div>
                  )}
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  {app.comingSoon && (
                    <span class="text-xs text-muted-foreground whitespace-nowrap">
                      {t('appDownload.comingSoon')}
                    </span>
                  )}
                  {app.apple && (
                    <a
                      href={app.apple}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${app.label} on the App Store`}
                      data-track-section="app-apple"
                      data-track-label={app.label}
                      data-apple-link
                      data-apple-href={app.apple}
                      class="inline-flex items-center justify-center size-7 rounded-full border border-border/60 hover:bg-accent transition-colors"
                    >
                      <Fragment set:html={appleIcon} />
                    </a>
                  )}
                  {app.android && (
                    <a
                      href={app.android}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${app.label} on Google Play`}
                      data-track-section="app-android"
                      data-track-label={app.label}
                      data-android-link
                      data-android-href={app.android}
                      class="inline-flex items-center justify-center size-7 rounded-full border border-border/60 hover:bg-accent transition-colors"
                    >
                      <Fragment set:html={androidIcon} />
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-xs uppercase tracking-wide text-muted-foreground mb-1.5 px-1">{t('tree.sectionWebsites')}</h2>
          <div class="flex flex-col gap-2">
            {websiteLinks.map((site) => (
              <a
                href={site.href}
                target="_blank"
                rel="noopener noreferrer"
                data-track-section="website"
                data-track-label={site.label}
                class="flex items-center gap-3 w-full rounded-xl border border-border/60 bg-card/70 px-4 py-2.5 hover:bg-accent hover:border-border transition-colors"
              >
                {site.logo ? (
                  <img src={site.logo} alt={site.label} class="size-9 rounded-full object-cover shrink-0" />
                ) : (
                  <span class={`size-9 rounded-full flex items-center justify-center text-xs font-bold shrink-0 ${site.bgColor} ${site.textColor}`}>
                    {site.initials}
                  </span>
                )}
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-medium">{site.label}</div>
                  {site.subtitle && (
                    <div class="text-xs text-muted-foreground truncate">{site.subtitle}</div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
      </div>
    </div>
    <StoreLinkDialogIsland lang={lang} client:idle />
    <script>
      import { trackEvent } from '@/lib/events'
      import { bindStoreLinkClicks, STORE_LINK_TAPPED_EVENT } from '@/lib/in-app-browser'

      trackEvent('pageView', { page: 'tree' })

      document.querySelectorAll<HTMLElement>('[data-track-label]').forEach((el) => {
        el.addEventListener('click', () => {
          trackEvent('ctaClick', {
            source: 'tree',
            section: el.dataset.trackSection ?? null,
            label: el.dataset.trackLabel ?? null,
          })
        })
      })

      bindStoreLinkClicks((href) => window.dispatchEvent(new CustomEvent(STORE_LINK_TAPPED_EVENT, { detail: href })))
    </script>
  </body>
</html>
