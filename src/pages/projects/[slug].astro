---
import BaseLayout from '@/layouts/BaseLayout.astro'
import LocalizedProjectDetail from '@/page-content/ProjectDetail.localized'
import { projectItems, keyToSlug } from '@/lib/projects-data'
import enMain from '@/i18n/locales/en/main.json'

export function getStaticPaths() {
  return projectItems.map((item) => ({
    params: { slug: keyToSlug(item.key) },
    props: { item },
  }))
}

const { item } = Astro.props
const { slug } = Astro.params
const copy = (enMain.projects.items as Record<string, { title: string; description: string }>)[item.key]
---

<BaseLayout
  lang="en"
  title={`${copy.title} | Pantelis Stanimeros`}
  description={copy.description}
  canonical={`https://stanimeros.com/projects/${slug}`}
  hreflangAlternates={[
    { hreflang: 'en', href: `https://stanimeros.com/projects/${slug}` },
    { hreflang: 'el', href: `https://stanimeros.com/el/projects/${slug}` },
    { hreflang: 'x-default', href: `https://stanimeros.com/projects/${slug}` },
  ]}
>
  <LocalizedProjectDetail lang="en" slug={slug} client:load />
</BaseLayout>
